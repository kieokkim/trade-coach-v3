OPENAI_API_KEY=your-openai-api-key
BYBIT_API_KEY=your-bybit-api-key
BYBIT_API_SECRET=your-bybit-api-secret

# LLM 설정 (openai 또는 groq)
LLM_PROVIDER=openai
GROQ_API_KEY=your-groq-api-key  # Groq 사용 시 필요

# Langfuse (선택 — 없으면 observability 비활성화)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
